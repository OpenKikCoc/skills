{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet work-item evidence manifest",
  "type": "object",
  "required": ["item", "claim", "evidence", "known_gaps"],
  "additionalProperties": false,
  "properties": {
    "item": {"type": "string", "description": "Card id; must equal the card front matter id"},
    "claim": {"type": "string", "description": "One-sentence completion claim, matching the acceptance criteria"},
    "acceptance_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "evidence_ref"],
        "properties": {
          "criterion": {"type": "string"},
          "evidence_ref": {"type": "string", "description": "id of an evidence entry"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["commit", "pr", "ci", "test", "artifact", "report", "doc", "host_job"]},
          "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "kind=commit: full commit SHA"},
          "remote_ref": {"type": "string", "description": "kind=commit: e.g. origin/fleet/w-12; must be pushed"},
          "url": {"type": "string"},
          "command": {"type": "string", "description": "kind=test: exact command run"},
          "result": {"type": "string", "description": "kind=test/ci: passed | failed | n/a, with counts"},
          "path": {"type": "string", "description": "kind=artifact/report/test log: path inside the item work directory"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "receipt": {"type": "string", "description": "kind=host_job: receipt path from the host queue"},
          "note": {"type": "string"}
        }
      }
    },
    "known_gaps": {"type": "array", "items": {"type": "string"}, "description": "Unverified or deferred points; [] if none"}
  }
}
